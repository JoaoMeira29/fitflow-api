# Copy this file to .env and fill in your own values.

# PostgreSQL connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://fitflow:fitflow@localhost:5432/fitflow

# Secret key used to sign JWT tokens
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Login rate limit: wrong passwords allowed for one email inside the window
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Safety limits for calorie targets
# Lowest daily calorie target the app will ever return, in kcal
MIN_DAILY_CALORIES_MALE=1500
MIN_DAILY_CALORIES_FEMALE=1200
# Largest weight change per week, as a percentage of body weight
MAX_WEEKLY_WEIGHT_CHANGE_PERCENT=1.0

# LLM used to generate plans
# "ollama" is a local model (free); "anthropic" is hosted Claude (paid)
LLM_PROVIDER=ollama
# Leave empty for the provider's default: qwen2.5:7b for ollama,
# claude-opus-5-5 for anthropic
LLM_MODEL=
# Let the model call the nutrition calculator tool while it builds a diet
# plan. Works well with Claude; the small local model often gets it wrong
LLM_USE_TOOLS=false
# Address of the Ollama server (ollama only)
LLM_BASE_URL=http://localhost:11434
# API key from https://platform.claude.com (anthropic only). Never commit it.
ANTHROPIC_API_KEY=
# Seconds to wait for one answer from the model
LLM_TIMEOUT_SECONDS=180
# Extra attempts when the model times out or cannot be reached
LLM_MAX_RETRIES=2
